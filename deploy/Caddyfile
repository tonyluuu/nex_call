{
	# 浏览器用 IP 访问时不发送 SNI，需要指定默认证书
	default_sni {$PUBLIC_IP}
	auto_https off
}

https://{$PUBLIC_IP} {
	tls /certs/fullchain.pem /certs/privkey.pem

	encode gzip

	# 访问 /nexcall 时 重定向到 /nexcall/
	handle /nexcall {
    	redir /nexcall/ permanent
	}

	# 剥掉 /nexcall 前缀后再分发，后端和 LiveKit 仍看到原来的路径
	handle_path /nexcall/* {
		handle /api/* {
			reverse_proxy call-server:8080
		}
		handle /ws/* {
			reverse_proxy call-server:8080
		}
		handle /healthz {
			reverse_proxy call-server:8080
		}
		handle /rtc* {
			reverse_proxy host.docker.internal:7880
		}
		handle {
			root * /srv/web
			try_files {path} /index.html
			file_server
		}
	}
}

http://{$PUBLIC_IP} {
	handle /.well-known/acme-challenge/* {
		root * /srv/acme
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}
