# 腾讯云弹性公网 IP（EIP）
PUBLIC_IP=203.0.113.10

# Let's Encrypt 账号邮箱（到期提醒；必须是真实邮箱，不能用 example.com）
ACME_EMAIL=you@example.com

# LiveKit API 密钥，生成方式：openssl rand -hex 8 / openssl rand -base64 32
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Web 登录会话签名密钥：openssl rand -base64 32
SESSION_SECRET=change-me-session-secret
