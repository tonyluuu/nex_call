# /etc/nexcall/device.env（权限 600）
# 服务器地址，公网 IP + HTTPS，带 /nexcall 前缀
SERVER_URL=https://203.0.113.10/nexcall
# 在服务器执行 call-server device add <ID> <名称> 获得
DEVICE_ID=pi1
DEVICE_SECRET=

# 服务端用自签名证书兜底时，把服务器的 deploy/certs/fullchain.pem 拷到这里并取消注释
#CA_CERT=/etc/nexcall/server.pem

# 短按提醒的 Web 用户名，留空则提醒所有在线用户。通话中短按改为静音。
CALL_TARGET=
# 通话状态文件（offline / idle / active），音乐播放器靠它在通话开始时暂停
CALL_STATE_FILE=/run/nexcall/call-state

# 音频：默认使用回声消除设备（setup.sh 在 PipeWire 或 PulseAudio 上设为默认）
AUDIO_BACKEND=auto
CAPTURE_DEVICE=
PLAYBACK_DEVICE=
AUDIO_PERIOD_MS=10
OPUS_BITRATE=24000
OPUS_PACKET_LOSS_PERC=10
OPUS_DTX=true
JITTER_TARGET_MS=60
JITTER_MAX_MS=300
# 网页语音通常比测试音轻得多，小喇叭听着偏小时调大。2 约 +6dB，3 约 +10dB，过大时会被软限幅压住
PLAYBACK_GAIN=2.5
# 管理页调节的是默认回声消除设备下面的硬件声卡。只有自动识别不到时才指定名称子串。
#VOLUME_SINK=
#VOLUME_SOURCE=
STATS_INTERVAL=10s

# GPIO（gpioinfo 查看线号）。按键接 GPIO 与 GND 之间；LED 串电阻接 GPIO 与 GND 之间。-1 表示不用
GPIO_CHIP=gpiochip0
BUTTON_LINE=-1
LED_LINE=-1
LED_ACTIVE_LOW=false
LONG_PRESS=1500ms

LOG_LEVEL=info
