[Unit]
Description=NexCall device agent
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
# PipeWire 是按用户运行的，服务必须以该用户身份运行并能访问其运行时目录。
# install.sh 会把 orangepi / 1000 替换成实际用户和 UID。
User=orangepi
SupplementaryGroups=audio gpio
EnvironmentFile=/etc/nexcall/device.env
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
ExecStart=/usr/local/bin/device-agent
Restart=always
RestartSec=3

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
